[Unit]
Description=HINT Human Interrupt
# HINT managed user service; install.sh fills in this command's absolute path.

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/share/hint/venv/bin/hint --serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=default.target
