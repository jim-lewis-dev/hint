#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for ARGUMENT in "$@"; do
  if [[ "$ARGUMENT" == --ready ]]; then
    export HINT_SOURCE_DIR="$HERE"
    exec python3 "$HERE/hint_ready.py" "$@"
  fi
done
case "${XDG_DATA_HOME:-}" in
  /*) HINT_DATA_HOME="$XDG_DATA_HOME" ;;
  *) HINT_DATA_HOME="$HOME/.local/share" ;;
esac
HINT_COMMAND="$HINT_DATA_HOME/hint/venv/bin/hint"
if [[ ! -x "$HINT_COMMAND" ]]; then
  printf 'HINT is not installed. Run ./hint --ready first.\n' >&2
  exit 1
fi
exec "$HINT_COMMAND" "$@"
